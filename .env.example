# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional default alert channel. Can also be set later with /set_channel
DISCORD_CHANNEL_ID=

# Optional extra destination (in addition to the channel, if both are set)
DISCORD_WEBHOOK_URL=

# Optional: sync slash commands instantly to one guild while testing
# Leave empty to register commands globally (can take up to an hour)
DISCORD_GUILD_ID=

# Watcher cadence (seconds). Default 420 (~7 minutes) with ±90s jitter.
CHECK_INTERVAL_SECONDS=420
CHECK_JITTER_SECONDS=90

# HoYoLAB language header, e.g. en-us, zh-cn, ja-jp
HOYOLAB_LANG=en-us

# SQLite path for seen post IDs
SQLITE_PATH=data/seen_posts.db

# Extra giveaway keywords, comma-separated (matched against title + body)
RAFFLE_KEYWORDS=

# Gemini extracts result/end dates only after keyword detection.
# Leave empty to keep alerts working and queue date extraction until configured.
GEMINI_API_KEY=
# Optional backup keys, tried in order on quota/auth errors; supports _2 through _20.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash
# Optional models used on 404 or repeated 5xx; supports _2 through _20.
GEMINI_FALLBACK_MODEL=
GEMINI_FALLBACK_MODEL_2=
# Minimum delay between requests per process; adjust to your AI Studio quota.
GEMINI_MIN_INTERVAL_SECONDS=15

# Missing timezone defaults to this IANA zone; date-only reminders use this hour.
REMINDER_TIMEZONE=Asia/Singapore
REMINDER_DEFAULT_HOUR=18
REMINDER_POLL_SECONDS=60
HISTORICAL_CATCHUP_DAYS=30
